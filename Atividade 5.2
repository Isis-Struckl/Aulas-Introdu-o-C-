using System;

public class Program
{
    public static void Main()
    {
        Console.Write("Digite o valor da compra: ");
        double valorCompra = Convert.ToDouble(Console.ReadLine());

        Console.Write("Digite o percentual de desconto: ");
        double desconto = Convert.ToDouble(Console.ReadLine());

        double valorDesconto = valorCompra * desconto / 100;
        double valorFinal = valorCompra - valorDesconto;

        Console.WriteLine($"O valor do desconto é: {valorDesconto:F2}");
        Console.WriteLine($"O valor final da compra com desconto é: {valorFinal:F2}");
    }
}
